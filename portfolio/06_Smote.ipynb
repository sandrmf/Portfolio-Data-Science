# DADOS BALANCEADOS COM SMOTE

from imblearn.over_sampling import SMOTE

# Balanceando os dados com SMOTE
smote = SMOTE(random_state=42)
X_train_res, y_train_res = smote.fit_resample(X_train, y_train)

print("Dados balanceados com SMOTE:")
print("Formato X:", X_train_res.shape)
print("Distribuição de classes:", y_train_res.value_counts())

from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score

# Treina a árvore com os dados balanceados (todos disponíveis após SMOTE)
modelo_arvore_real = DecisionTreeClassifier(random_state=42)
modelo_arvore_real.fit(X_train_res, y_train_res)

# Faz as previsões com a base de teste original (desbalanceada)
y_pred_real = modelo_arvore_real.predict(X_test)

# Exibe os resultados
print("Matriz de Confusão:")
print(confusion_matrix(y_test, y_pred_real))

print("\n📋 Relatório de Classificação:")
print(classification_report(y_test, y_pred_real))

print("\nAcurácia:")
print(accuracy_score(y_test, y_pred_real))
