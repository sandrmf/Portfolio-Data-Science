import pandas as pd

# Carrega o dataset
df = pd.read_csv(r'C:\Users\User\Documents\Portfolio\Data\creditcard.csv')

# Mostra as colunas disponíveis
print("Colunas do DataFrame:", df.columns.tolist())

# Garante que a coluna 'Class' está no tipo correto
df['Class'] = df['Class'].astype(int)

# Verifica valores únicos
print("Valores únicos na coluna 'Class':", df['Class'].unique())

# Conta quantas transações fraudulentas e não fraudulentas existem
contagem_classes = df['Class'].value_counts()
print("\nContagem por classe:\n", contagem_classes)

# Define o número de amostras de cada classe
n_amostras = min(contagem_classes[0], contagem_classes[1])
print(f"\nNúmero de amostras para balanceamento: {n_amostras}")

# Cria amostras balanceadas
fraudes = df[df['Class'] == 1].sample(n=n_amostras, random_state=42)
nao_fraudes = df[df['Class'] == 0].sample(n=n_amostras, random_state=42)

# Junta as amostras e embaralha
df_balanceado = pd.concat([fraudes, nao_fraudes]).sample(frac=1, random_state=42)

# Salva a amostra balanceada
df_balanceado.to_csv('amostra_balanceada.csv', index=False)
print("\nAmostra balanceada salva com sucesso!")

# Estatísticas descritivas
print("\nResumo estatístico da amostra:")
print(df_balanceado.describe())
