# 1. Importando bibliotecas
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Estilo dos gráficos

# 2. Lendo a amostra balanceada
df = pd.read_csv('C:/Users/User/Documents/Portfolio/amostra_balanceada.csv')
# 3. Exibindo as primeiras linhas
df.head()

# 4. Informações gerais
print("Formato do DataFrame:", df.shape)
print("\nTipos de dados:")
print(df.dtypes)

print("\nValores ausentes:")
print(df.isnull().sum())

# 5. Estatísticas descritivas
df.describe()

# 6. Distribuição da variável alvo
sns.countplot(x='Class', data=df)
plt.title('Distribuição das Classes (0 = Normal, 1 = Fraude)')
plt.xlabel('Classe')
plt.ylabel('Contagem')
plt.show()

# 7. Correlação entre variáveis
plt.figure(figsize=(12, 10))
sns.heatmap(df.corr(), cmap='coolwarm', center=0)
plt.title('Mapa de Correlação das Variáveis')
plt.show()
