# TREINAR O MODELO DE DECISÃO

from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score
import seaborn as sns
import matplotlib.pyplot as plt

# 1. Treinando a árvore de decisão
dt_model = DecisionTreeClassifier(random_state=42)
dt_model.fit(X_train_scaled, y_train)


# 2. Fazendo previsões
y_pred_dt = dt_model.predict(X_test_scaled)

# 3. Avaliação
print("🔍 Matriz de Confusão:")
print(confusion_matrix(y_test, y_pred_dt))

print("\n📋 Relatório de Classificação:")
print(classification_report(y_test, y_pred_dt))

print("\n✅ Acurácia:")
print(accuracy_score(y_test, y_pred_dt))

# 4. Visualizando a matriz com gráfico
plt.figure(figsize=(6,4))
sns.heatmap(confusion_matrix(y_test, y_pred_dt), annot=True, fmt='d', cmap='Blues')
plt.title("Matriz de Confusão - Árvore de Decisão")
plt.xlabel("Classe Predita")
plt.ylabel("Classe Real")
plt.show()

# Visualizando a árvore de decisão

from sklearn.tree import DecisionTreeClassifier

# Criação do modelo de árvore de decisão
modelo_arvore = DecisionTreeClassifier(random_state=42)

# Treinamento do modelo
modelo_arvore.fit(X_train_scaled, y_train)

from sklearn.tree import plot_tree
import matplotlib.pyplot as plt

plt.figure(figsize=(20, 10))
plot_tree(modelo_arvore, 
          filled=True, 
          rounded=True, 
          feature_names=X.columns, 
          class_names=["Normal", "Fraude"])
plt.title("Visualização da Árvore de Decisão")
plt.show()
